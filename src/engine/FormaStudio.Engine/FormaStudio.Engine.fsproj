<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EchelonFoundry.Aegis.Core" Version="1.0.0" />
    <!-- Aegis.Core 1.0.0 requires FSharp.Core >= 10.1.400; pin it so the SDK default cannot downgrade it (NU1605). -->
    <PackageReference Update="FSharp.Core" Version="10.1.400" />
  </ItemGroup>

  <ItemGroup>
    <!-- The public Forma workflow capability (vendored pre-release; see vendor/forma/SOURCE.md). -->
    <ProjectReference Include="../../../vendor/forma/workflow/src/Forma.Workflow.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Identity.fs" />
    <Compile Include="Json.fs" />
    <Compile Include="Geometry.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="MetadataRules.fs" />
    <Compile Include="Profiles.fs" />
    <Compile Include="ProjectOps.fs" />
    <Compile Include="AppearanceResolution.fs" />
    <Compile Include="Validation.fs" />
    <Compile Include="Components.fs" />
    <Compile Include="Commands.fs" />
    <Compile Include="Editor.fs" />
    <Compile Include="Codec.fs" />
    <Compile Include="Samples.fs" />
    <Compile Include="Export.fs" />
    <Compile Include="Projection.fs" />
    <Compile Include="Diff.fs" />
    <Compile Include="Fragment.fs" />
    <Compile Include="Templates.fs" />
    <Compile Include="WorkflowLibrary.fs" />
    <Compile Include="HtmlExport.fs" />
    <Compile Include="Designs.fs" />
    <Compile Include="EditorApp.fs" />
  </ItemGroup>
</Project>
