<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!--
    .NET WebAssembly host for the F# engine. It contains no application decisions:
    Interop.cs only marshals Limen JSON messages to EditorApp.dispatchText and holds
    the single current-state cell (see src/kernel for the browser side).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- F# formatting (sprintf) relies on reflection that trimming can remove; correctness first. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../engine/FormaStudio.Engine/FormaStudio.Engine.fsproj" />
  </ItemGroup>
</Project>
