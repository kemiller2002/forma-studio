{
  "name": "@echelon-foundry/forma-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Visual application specification environment built around Forma, Limen, Ordo, and F#.",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@echelon-foundry/design-system": "https://github.com/kemiller2002/forma/releases/download/v0.4.1/echelon-foundry-design-system-0.4.1.tgz",
    "@echelon-foundry/limen": "0.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "typescript": "5.9.3"
  },
  "scripts": {
    "requirements:validate": "node scripts/validate-requirements.mjs",
    "schema:validate": "node scripts/validate-schema.mjs",
    "site:build": "node scripts/build-site.mjs",
    "check": "npm run requirements:validate && npm run schema:validate && npm run vendor:check && npm run site:build",
    "app:build": "node scripts/build-app.mjs",
    "app:test": "npm run html:consumer && playwright test",
    "engine:test": "dotnet run --project tests/FormaStudio.Engine.Tests -c Release",
    "vendor:check": "node scripts/sync-forma.mjs --check",
    "vendor:release": "node scripts/sync-forma.mjs --release",
    "html:export": "node scripts/export-reference-html.mjs",
    "html:check": "node scripts/export-reference-html.mjs --check",
    "html:consumer": "node examples/html-consumer/build.mjs vendor/forma",
    "proof:external": "node scripts/proof-external.mjs"
  }
}
